# Full downloaded datasets are local inputs. The sampled exp_*.jsonl files may
# be versioned so experiments remain reproducible.
attention/exp_data/*_full.jsonl

# Python/runtime caches and locally compiled parser libraries.
__pycache__/
*.py[cod]
build/*.so

# Generated experiment artifacts. Existing historical artifacts that are
# already tracked remain tracked; new runs stay local.
graph_info/
dfg_results/
structural_probe/
analysis_results/
DirectProbe/pilot_100/
attention/exp_data/pilot_100/

# Only the minimal, pinned parser sources required by Language.build_library
# are versioned for Go and JavaScript; local full grammar clones stay ignored.
tree-sitter-go/
tree-sitter-javascript/

# Final DirectProbe feature matrices are multi-gigabyte reproducible
# intermediates. Keep the compact entities, dataset manifests, configs, solver
# outputs, and validation manifests in Git instead.
DirectProbe/final_3000/data/**/embeddings/

# Runtime-only DirectProbe recovery and progress artifacts.
DirectProbe/final_3000/*.log
DirectProbe/final_3000/*.lock
DirectProbe/final_3000/*dry_run*.json
DirectProbe/final_3000/*_logs/
DirectProbe/final_3000/preparation_logs/
DirectProbe/final_3000/recovery/
DirectProbe/final_3000/interrupted_runs/
DirectProbe/final_3000/interrupted_results_archive/
